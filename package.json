{
  "name": "x-dialog-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter @x-dialog/react build && pnpm registry:build && pnpm --filter demo build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:build": "shadcn build registry.json --output apps/demo/public/r",
    "registry:validate": "shadcn registry validate ./registry.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @x-dialog/react check:package",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @x-dialog/react build && changeset publish"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@x-dialog/react": "workspace:*",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "lucide-react": "^1.80.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8"
  }
}
